actions_per_user     : {'alice': 4, 'bob': 3, 'carol': 2}
user_with_most_failures : one of ('alice',1)/('bob',1) — alice wins the tie
counts_by_day        : {'2026-08-01': 4, '2026-08-02': 5}
busiest_day          : '2026-08-02'
success_rate         : 0.78